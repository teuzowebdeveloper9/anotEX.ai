# App
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Azure Database for PostgreSQL
DATABASE_URL=

# Auth própria (magic link + JWT)
JWT_SECRET=
JWT_EXPIRES_IN=1h
MAGIC_LINK_EXPIRES_IN_MINUTES=15
FRONTEND_URL=http://localhost:5173

# Azure Communication Services (envio dos magic links)
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

# OpenAI
OPENAI_API_KEY=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=audios

# Redis (Azure Managed Redis — porta 10000, TLS)
REDIS_HOST=
REDIS_PORT=10000
REDIS_PASSWORD=
REDIS_TLS=true

# AbacatePay
ABACATEPAY_API_KEY=
ABACATEPAY_API_BASE_URL=https://api.abacatepay.com/v2
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_PUBLIC_HMAC_KEY=
# Catálogo autoritativo (preço é resolvido no backend, nunca vem do cliente):
# "productId:precoEmCentavos:Nome" separados por vírgula
ABACATEPAY_PRODUCTS=prod_anotex_pro_mensal:3990:AnotEx Pro
ABACATEPAY_RETURN_URL=
ABACATEPAY_COMPLETION_URL=

# Limits
MAX_AUDIO_SIZE_MB=100
SIGNED_URL_EXPIRES_IN_SECONDS=900

# YouTube
YOUTUBE_API_KEY=

# yt-dlp / YouTube download mitigation
YTDLP_JS_RUNTIME=node
YTDLP_COOKIES_PATH=
YTDLP_PROXY_URL=
