ABACATEPAY_RETURN_URL=
ABACATEPAY_COMPLETION_URL=

# Limits
MAX_AUDIO_SIZE_MB=100
SIGNED_URL_EXPIRES_IN_SECONDS=900

# yt-dlp / YouTube download mitigation
YTDLP_JS_RUNTIME=node
YTDLP_COOKIES_PATH=
YTDLP_PROXY_URL=
