SUPABASE_SERVICE_ROLE_KEY=

# Groq
GROQ_API_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
